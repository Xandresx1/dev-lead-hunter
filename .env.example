# ============================================================
#  Dev Lead Hunter - configuracion (copia este archivo a .env)
# ============================================================

# ---------- NOTIFICACIONES (ntfy) ----------
# Instala la app ntfy (Android/iOS/web https://ntfy.sh/app) y SUSCRIBETE a este topic.
# Usa un nombre dificil de adivinar (cualquiera que lo sepa puede leer tus alertas).
NTFY_TOPIC=devleads-pe-7x4k9q2m
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # solo si usas un servidor ntfy con autenticacion
NOTIFY_ERRORS=true       # avisa (max 1 vez / 6h por fuente) si una fuente falla

# ---------- IA (Google Gemini, gratis) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=900          # tope de clasificaciones/dia (free tier ~1000 RPD)
GEMINI_MIN_INTERVAL_SEC=4.5     # free tier ~15 RPM

# ---------- APIFY (Facebook / LinkedIn / X) ----------
# https://console.apify.com -> Settings -> API & Integrations -> Personal API tokens
APIFY_TOKEN=
APIFY_MONTHLY_BUDGET_USD=4.5    # el bot deja de llamar a Apify al pasar este gasto mensual (plan free = $5)
APIFY_MAX_CHARGE_PER_RUN_USD=0.15

# ---------- FILTRO ----------
MIN_SCORE=65                    # notificar solo leads con score >= este valor (0-100)
LOOP_TICK_MINUTES=5             # cada cuantos minutos revisa que fuentes "tocan"
MAX_CLASSIFY_PER_TICK=40        # max posts que pasan por Gemini en cada tick (el resto queda pendiente)

# ---------- FUENTE: Freelancer.com (gratis, sin key) ----------
FREELANCER_ENABLED=true
FREELANCER_INTERVAL_MINUTES=10
FREELANCER_QUERIES_ES=sistema,aplicacion,app movil,pagina web,software,automatizacion,bot,tesis
FREELANCER_QUERIES_EN=need a developer,build an app,web application,software system,automation bot
FREELANCER_LIMIT_PER_QUERY=15

# ---------- FUENTE: Reddit (gratis; suele estar bloqueado desde IPs cloud, se omite solo) ----------
REDDIT_ENABLED=true
REDDIT_INTERVAL_MINUTES=20
REDDIT_SUBREDDITS=forhire,hiring,slavelabour,Entrepreneur,smallbusiness,startups,PERU,mexico,argentina,es
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ---------- FUENTE: Facebook grupos PUBLICOS (Apify, ~$0.005 por post leido) ----------
FACEBOOK_ENABLED=true
FACEBOOK_INTERVAL_MINUTES=720           # 12h. Baja a 180-360 si subes el presupuesto de Apify
FACEBOOK_GROUPS=https://www.facebook.com/groups/programadoresperu
FACEBOOK_POSTS_PER_GROUP=5
FACEBOOK_NEWER_THAN=2 days

# ---------- FUENTE: LinkedIn posts (Apify, ~$0.0012 por post) ----------
LINKEDIN_ENABLED=true
LINKEDIN_INTERVAL_MINUTES=720
LINKEDIN_KEYWORDS=busco desarrollador,necesito un sistema
LINKEDIN_POSTS_PER_KEYWORD=10           # minimo 10 (lo exige el actor)
LINKEDIN_DATE_FILTER=past-24h           # past-24h | past-week | past-month

# ---------- FUENTE: X / Twitter (Apify, gratis pero ~50 runs/mes) ----------
TWITTER_ENABLED=true
TWITTER_INTERVAL_MINUTES=960            # 16h = ~45 runs/mes
TWITTER_MAX_ITEMS=20
# TWITTER_QUERY=("busco programador" OR "necesito un programador" OR "looking for a developer") -is:retweet

# ---------- FUENTE: Telegram grupos publicos (opcional, experimental) ----------
TELEGRAM_ENABLED=false
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_GROUPS=https://t.me/freelancersperu,https://t.me/programadoreslatam
# TELEGRAM_INTERVAL_MINUTES=15

# ---------- OTROS ----------
DATA_DIR=./data
LOG_LEVEL=INFO
